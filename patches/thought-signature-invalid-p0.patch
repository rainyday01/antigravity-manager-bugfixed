+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn thinking_msg(sig: &str) -> Message {
+        Message {
+            role: "assistant".to_string(),
+            content: MessageContent::Array(vec![ContentBlock::Thinking {
+                thinking: "reason".to_string(),
+                signature: Some(sig.to_string()),
+                cache_control: None,
+            }]),
+        }
+    }
+
+    fn thinking_sig(messages: &[Message]) -> Option<String> {
+        match &messages[0].content {
+            MessageContent::Array(blocks) => match &blocks[0] {
+                ContentBlock::Thinking { signature, .. } => signature.clone(),
+                _ => None,
+            },
+            _ => None,
+        }
+    }
+
+    #[test]
+    fn sanitizer_keeps_thinking_on_family_cache_miss() {
+        SignatureCache::global().clear();
+        let sig = "a".repeat(80);
+        let mut messages = vec![thinking_msg(&sig)];
+        filter_invalid_thinking_blocks_with_family(&mut messages, Some("gemini-3.7-flash-high"));
+        assert_eq!(thinking_sig(&messages).as_deref(), Some(sig.as_str()));
+    }
+
+    #[test]
+    fn sanitizer_drops_cross_family_thinking() {
+        SignatureCache::global().clear();
+        let sig = "b".repeat(80);
+        SignatureCache::global().cache_thinking_family(sig.clone(), "claude-sonnet".to_string());
+        let mut messages = vec![thinking_msg(&sig)];
+        filter_invalid_thinking_blocks_with_family(&mut messages, Some("gemini-3.7-flash-high"));
+        match &messages[0].content {
+            MessageContent::Array(blocks) => {
+                assert!(!matches!(blocks[0], ContentBlock::Thinking { .. }));
+            }
+            _ => panic!("expected remaining content"),
+        }
+    }
+}
